---
// Header.astro — Persistent site header
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="INDEX_000 Home">INDEX_000</a>

    <nav class="nav-desktop" aria-label="Main navigation">
      <a href="/shop" class="nav-link">[SHOP]</a>
      <a href="#about" class="nav-link">[ABOUT]</a>
      <button class="nav-link cart-toggle" type="button" aria-label="Open cart">
        [CART<span class="cart-badge" id="cart-count" aria-label="items in cart">0</span>]
      </button>
    </nav>

    <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <nav class="nav-mobile" aria-label="Mobile navigation">
    <a href="/shop" class="nav-link">[SHOP]</a>
    <a href="#about" class="nav-link">[ABOUT]</a>
    <button class="nav-link cart-toggle" type="button" aria-label="Open cart">
      [CART<span class="cart-badge" aria-hidden="true">0</span>]
    </button>
  </nav>
</header>

<script>
  const hamburger = document.querySelector('.hamburger');
  const mobileNav = document.querySelector('.nav-mobile');

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    hamburger.classList.toggle('is-active');
    mobileNav?.classList.toggle('is-open');
  });

  // Sync mobile badge with desktop badge
  function syncMobileBadge() {
    const desktopCount = document.getElementById('cart-count');
    const mobileBadges = document.querySelectorAll('.nav-mobile .cart-badge');
    if (desktopCount) {
      mobileBadges.forEach(b => b.textContent = desktopCount.textContent);
    }
  }

  const observer = new MutationObserver(syncMobileBadge);
  const countEl = document.getElementById('cart-count');
  if (countEl) observer.observe(countEl, { childList: true, characterData: true, subtree: true });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: var(--color-bg-primary, #1A1A1A);
    border-bottom: 1px solid var(--color-border, rgba(235, 234, 229, 0.15));
    z-index: 1000;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3rem);
  }

  /* ── Brand ── */
  .brand {
    font-family: var(--font-heading, 'JetBrains Mono', monospace);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent, #EBEAE5);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ── Desktop Nav ── */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-accent, #EBEAE5);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    opacity: 0.65;
  }

  /* ── Cart Badge ── */
  .cart-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    margin-left: 2px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--color-accent, #EBEAE5);
    color: var(--color-bg-primary, #1A1A1A);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 0.55rem;
    line-height: 1;
    vertical-align: middle;
  }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent, #EBEAE5);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hamburger.is-active .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .hamburger.is-active .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ── Mobile Nav ── */
  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem clamp(1rem, 4vw, 3rem) 2rem;
    background: var(--color-bg-primary, #1A1A1A);
    border-bottom: 1px solid var(--color-border, rgba(235, 234, 229, 0.15));
  }

  .nav-mobile.is-open {
    display: flex;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nav-desktop {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>
